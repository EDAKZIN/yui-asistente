{
    "version": "1.0.0",
    "paths": {
        "llama_model": "unsloth/Llama-3.2-3B-Instruct",
        "chromadb_path": "data/chromadb",
        "logs_dir": "logs",
        "voice_samples_dir": "voice_samples"
    },
    "models": {
        "whisper": {
            "model_size": "base",
            "language": "es",
            "compute_type": "float16"
        },
        "llama": {
            "max_length": 512,
            "temperature": 0.7,
            "top_p": 0.9,
            "device": "cuda"
        }
    },
    "audio": {
        "sample_rate": 16000,
        "channels": 1,
        "chunk_duration_ms": 30
    },
    "ui": {
        "theme": "dark",
        "show_transcripts": true
    }
}